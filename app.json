{
  "expo": {
    "name": "FitStep",
    "slug": "fitstep",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fitstep",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F0C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitstep.app",
      "infoPlist": {
        "NSMotionUsageDescription": "FitStep usa el sensor de movimiento para contar tus pasos y calcular tu progreso diario.",
        "NSFaceIDUsageDescription": "FitStep usa Face ID para proteger el acceso a tu cuenta."
      }
    },
    "android": {
      "package": "com.fitstep.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["ACTIVITY_RECOGNITION"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0F0C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
